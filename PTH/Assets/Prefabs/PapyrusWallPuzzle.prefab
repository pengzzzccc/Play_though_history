  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A tall reed called papyrus grew in thick marshes along the banks of the <link=\"gap-0\"><nobr><color=#00000000>Nile</color></nobr></link>. Around <link=\"gap-1\"><nobr><color=#00000000>3000 BCE</color></nobr></link>, Egyptian craftspeople learned to slice the soft inner reed into thin strips.\n\n<nobr>They laid the strips in <link=\"gap-2\"><color=#00000000>two crossed layers</color></link></nobr>, then pressed and dried them until the plant's own sap bound them into a single sheet.\n\nSheets were glued end to end to make <link=\"gap-3\"><nobr><color=#00000000>long scrolls</color></nobr></link>, which scribes wrote on with reed pens and ink made from soot."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
