/* Shared design tokens and styles for all UI Toolkit screens.
   Reference layout baseline: 960x600 (PanelSettings ScaleWithScreenSize, match 0.5). */

:root {
    --color-menu-bg: rgb(9, 14, 19);
    --color-button: rgba(33, 72, 111, 0.42);
    --color-button-hover: rgba(80, 237, 255, 0.33);
    --color-pause-overlay: rgba(5, 8, 10, 0.9);
    --color-settings-panel: rgba(20, 28, 36, 0.98);
    --color-text: rgb(235, 240, 242);
    --color-focus: rgb(240, 245, 247);
    --size-button-width: 320px;
    --size-button-height: 52px;
}

.screen {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
}

.hidden {
    display: none;
}

/* ---- Main menu ---- */

.screen-background {
    background-color: var(--color-menu-bg);
    align-items: center;
}

.menu-title {
    margin-top: 85px;
    margin-bottom: 10px;
    width: 820px;
    height: 80px;
    font-size: 48px;
    color: var(--color-text);
    -unity-text-align: middle-center;
}

.menu-status {
    margin-bottom: 91px;
    width: 800px;
    height: 70px;
    font-size: 22px;
    color: var(--color-text);
    -unity-text-align: middle-center;
}

.menu-buttons {
    align-items: center;
}

.menu-button {
    width: var(--size-button-width);
    height: var(--size-button-height);
    margin-bottom: 13px;
    font-size: 24px;
    color: var(--color-text);
    background-color: var(--color-button);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 4px;
    -unity-text-align: middle-center;
}

.menu-button:hover {
    background-color: var(--color-button-hover);
}

.menu-button:focus {
    border-color: var(--color-focus);
}

.menu-button:disabled {
    opacity: 0.45;
}

/* ---- Era HUD ---- */

.hud-heading {
    position: absolute;
    top: 11px;
    left: 55px;
    right: 55px;
    height: 45px;
    font-size: 20px;
    color: var(--color-text);
    -unity-text-align: middle-center;
}

.hud-controls {
    position: absolute;
    bottom: 12px;
    left: 30px;
    right: 30px;
    height: 36px;
    font-size: 17px;
    color: var(--color-text);
    -unity-text-align: middle-center;
}

.hud-crosshair {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    font-size: 24px;
    color: var(--color-text);
    -unity-text-align: middle-center;
}

/* ---- Pause overlay ---- */

.overlay {
    background-color: var(--color-pause-overlay);
}

.pause-title {
    position: absolute;
    top: 75px;
    left: 0;
    right: 0;
    height: 70px;
    font-size: 42px;
    color: var(--color-text);
    -unity-text-align: middle-center;
}

.pause-buttons {
    position: absolute;
    left: 50%;
    top: 50%;
    margin-left: -160px;
    margin-top: -91px;
}

.device-message {
    position: absolute;
    bottom: 40px;
    left: 55px;
    right: 55px;
    height: 60px;
    font-size: 18px;
    color: var(--color-text);
    -unity-text-align: middle-center;
}

/* ---- Settings panel (shared template, embedded in main menu and pause) ---- */

.settings-panel {
    position: absolute;
    top: 70px;
    left: 50%;
    margin-left: -230px;
    width: 460px;
    min-height: 440px;
    padding: 20px 24px;
    background-color: var(--color-settings-panel);
}

.settings-title {
    margin-bottom: 12px;
    font-size: 28px;
    color: var(--color-text);
    -unity-text-align: middle-left;
}

.tab-strip {
    flex-direction: row;
    margin-bottom: 12px;
}

.tab-button {
    flex-grow: 1;
    height: 36px;
    margin: 0 4px;
    font-size: 16px;
    color: var(--color-text);
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 3px;
    -unity-text-align: middle-center;
}

.tab-button:hover {
    background-color: rgba(255, 255, 255, 0.12);
}

.tab-button--active {
    background-color: var(--color-button);
    border-color: var(--color-focus);
}

.tab-page {
    flex-grow: 1;
}

.setting-dropdown {
    width: 100%;
    margin-bottom: 10px;
}

.setting-dropdown .unity-base-field__label {
    color: var(--color-text);
}

.setting-row {
    margin-bottom: 10px;
}

.setting-label {
    margin-bottom: 4px;
    font-size: 17px;
    color: var(--color-text);
}

.setting-slider {
    width: 100%;
}

.setting-toggle {
    width: 100%;
    height: 36px;
    margin-bottom: 10px;
    font-size: 17px;
    color: var(--color-text);
}

.back-button {
    align-self: center;
    margin-top: 8px;
    margin-bottom: 0;
}

/* ---- Artefact flashback ---- */

.flashback-overlay {
    align-items: center;
    justify-content: center;
    background-color: rgba(5, 8, 10, 0.98);
}

.flashback-card {
    width: 96%;
    height: 96%;
    padding: 12px 16px;
    background-color: var(--color-settings-panel);
    border-width: 1px;
    border-color: rgba(240, 245, 247, 0.2);
    border-radius: 8px;
}

.flashback-header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.flashback-eyebrow {
    flex-grow: 1;
}

.flashback-eyebrow, .flashback-counter {
    color: rgb(171, 207, 218);
    font-size: 12px;
    -unity-text-align: middle-left;
}

.flashback-counter {
    margin-right: 16px;
}

.flashback-title {
    margin-top: 4px;
    margin-bottom: 10px;
    color: var(--color-text);
    font-size: 24px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.flashback-image, .flashback-audio-placeholder {
    flex-grow: 1;
    min-height: 60px;
    background-color: rgba(255, 255, 255, 0.035);
    border-radius: 4px;
}

.flashback-image {
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}

.flashback-audio-placeholder {
    align-items: center;
    justify-content: center;
}

.flashback-listen {
    color: var(--color-text);
    font-size: 32px;
}

.flashback-description, .flashback-hint {
    color: rgb(190, 202, 209);
    font-size: 13px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.flashback-hint {
    margin-top: 6px;
    margin-bottom: 6px;
}

.flashback-buttons {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
}

.flashback-button {
    width: 100px;
    height: 34px;
    margin: 0;
    font-size: 15px;
    flex-shrink: 0;
}

.flashback-skip-button {
    width: 120px;
    height: 28px;
    font-size: 13px;
    background-color: rgba(255, 255, 255, 0.06);
}
