<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="SettingPageTemplate" src="project://database/Assets/UI/SettingPage.uxml?fileID=9197481963319205126&amp;guid=2e79d40fc07aa9c4fb1d154029eb4720&amp;type=3#SettingPage"/>
    <Style src="project://database/Assets/UI/Main.uss?fileID=7433441132597879392&amp;guid=2a160949d25289348a54b06a1e3c773c&amp;type=3#Main"/>
    <ui:VisualElement name="menu-panel" class="screen screen-background" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; top: -1px; bottom: 0; right: 0; left: -23px; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; background-image: url(&quot;project://database/Assets/UI/UI%20Visual%20Assets/MAINBG.png?fileID=2800000&amp;guid=c8f9061717f974943ab3502bb2c2e699&amp;type=3#MAINBG&quot;); background-size: 100% 100%; visibility: visible;">
        <ui:Label name="title" text="UNKNOWN &#10;TECHNOLOGY" class="menu-title" style="height: 68px; bottom: -100px; left: -65px; -unity-text-align: middle-left; white-space: pre; text-overflow: ellipsis;"/>
        <ui:VisualElement name="menu-buttons" class="menu-buttons" style="align-self: flex-start; width: 416px; top: 150px; left: -30px;">
            <ui:Button name="play-button" text="Play" class="menu-button" style="background-color: rgba(9, 0, 255, 0.196); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; opacity: 1;"/>
            <ui:Button name="settings-button" text="Settings" class="menu-button" style="-unity-text-align: middle-center; background-color: rgba(9, 0, 255, 0.196); border-left-color: rgb(0, 146, 255); border-right-color: rgb(0, 146, 255); border-top-color: rgb(0, 146, 255); border-bottom-color: rgb(0, 146, 255); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; -unity-background-image-tint-color: rgb(255, 255, 255);"/>
            <ui:Button name="quit-button" text="Quit" class="menu-button" style="background-color: rgba(9, 0, 255, 0.196); border-left-color: rgb(0, 146, 255); border-right-color: rgb(0, 146, 255); border-top-color: rgb(0, 146, 255); border-bottom-color: rgb(0, 146, 255); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0;"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="play-panel" class="screen screen-background hidden">
        <ui:Label name="play-title" text="SELECT SAVE SLOT" class="menu-title"/>
        <ui:VisualElement name="menu-buttons" class="menu-buttons">
            <ui:Button name="slot-1-button" text="Slot 1 — Empty" class="menu-button"/>
            <ui:Button name="slot-2-button" text="Slot 2 — Empty" class="menu-button"/>
            <ui:Button name="slot-3-button" text="Slot 3 — Empty" class="menu-button"/>
            <ui:Button name="play-back-button" text="Back" class="menu-button"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:Instance template="SettingPageTemplate" name="settings" class="screen screen-background hidden"/>
</ui:UXML>
